{
  "expo": {
    "name": "ahoj",
    "slug": "ahoj",
    "version": "0.1.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ahoj",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ahoj.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ahoj needs your location to show nearby people.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ahoj uses your location in the background to keep your proximity feed updated.",
        "NSCameraUsageDescription": "ahoj needs your camera to post stories.",
        "NSPhotoLibraryUsageDescription": "ahoj needs your photos to post stories.",
        "NSMicrophoneUsageDescription": "ahoj needs your microphone for video stories."
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GMAPS_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0A2E"
      },
      "package": "app.ahoj.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GMAPS_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ahoj uses your location to show nearby people."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7B2FE7"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL": "http://localhost:3000",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
